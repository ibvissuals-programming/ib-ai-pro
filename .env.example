# ─────────────────────────────────────────────────────────────────────────────
# IB AI Studio Lab — Environment Variables
#
# Copy relevant keys to Replit Secrets (not to a .env file — Replit ignores it
# for secrets). Replit Secrets are NOT synced with GitHub: every time you
# reimport this project you must re-add them manually in the Secrets tab.
#
# Quick check after reimport:
#   node startup-secrets-check.cjs
#
# Tiers:
#   CRITICAL — server will not start without these
#   AI       — missing activates safe mode (all AI routes blocked)
#   SECURITY — insecure fallback used if missing
#   OPTIONAL — single feature degraded if missing
# ─────────────────────────────────────────────────────────────────────────────


# ── CRITICAL ──────────────────────────────────────────────────────────────────
# Server will NOT start without these.

# Auto-provisioned by the Replit PostgreSQL integration — do not set manually.
DATABASE_URL=

# Password for the CEO (admin) account "ibaiceo".
# Required on every fresh reimport so the account can be created in the new DB.
# Once the account exists in the database, this is no longer needed each boot —
# but safe to leave set.
CEO_PASSWORD=


# ── AI PROVIDER ───────────────────────────────────────────────────────────────
# Missing any of these activates safe mode (AI routes return 503).

# Google Gemini — primary AI provider (image gen, TTS, chat fallback, prompt expansion).
# Get free key: aistudio.google.com → Get API key
GEMINI_API_KEY=

# Groq — fast Llama 3.1 chat completions. Optional: Gemini is used as fallback.
# Get free key: console.groq.com → API keys
GROQ_API_KEY=


# ── SECURITY ──────────────────────────────────────────────────────────────────
# Missing these uses insecure fallbacks — fine for dev, bad for production.

# Signs and verifies user session JWTs.
# Set to any random string of 32+ characters.
# Without this, sessions reset on every server restart.
JWT_SECRET=

# Signs server-side session cookies.
# Set to any long random string. Falls back to a random per-process value if absent.
SESSION_SECRET=


# ── OPTIONAL — Image Features ─────────────────────────────────────────────────

# Fal.ai — enables true img2img editing (FLUX.1-dev).
# Without this, image editing falls back to text-to-image (subject identity not preserved).
# Free signup includes $10 credit (~3000+ edits): fal.ai → Account → API Keys
FAL_KEY=

# HuggingFace — enables FLUX.1-schnell image generation.
# Without this, HF image gen routes are disabled.
# huggingface.co → Settings → Access Tokens → New token (Read role)
HF_API_KEY=


# ── OPTIONAL — Admin / Recovery ───────────────────────────────────────────────

# Emergency key to reset the CEO account password via the recovery flow.
# Set to any secure random string.
CEO_RECOVERY_KEY=
