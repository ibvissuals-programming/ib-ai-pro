modules = ["nodejs-20", "web", "bash", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "IB AI Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "IB AI Backend"

[[workflows.workflow]]
name = "IB AI Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node /home/runner/workspace/scripts/kill-port.cjs 23765; node /home/runner/workspace/scripts/kill-port.cjs 5000; sleep 0.3; while true; do PORT=5000 pnpm --filter @workspace/ib-ai-v2 run dev; echo '[auto-restart] Vite exited, restarting in 0.3s...'; sleep 0.3; done"
waitForPort = 5000

[[workflows.workflow]]
name = "IB AI Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node /home/runner/workspace/scripts/kill-port.cjs 8080; node /home/runner/workspace/scripts/kill-port.cjs 8099; sleep 0.3; while true; do PORT=8099 pnpm --filter @workspace/api-server run dev; echo '[auto-restart] Backend exited, restarting in 0.3s...'; sleep 0.3; done"
waitForPort = 8099

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_gemini_ai_integrations:2.0.0", "javascript_database:1.0.0", "javascript_object_storage:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
CEO_USERNAME = "ibaiceo"
PORT = "8080"
USE_POSTGRES_STORAGE = "true"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 23765
externalPort = 3000
